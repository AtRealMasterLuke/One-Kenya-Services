# Copy to .env and fill in. docker compose reads it automatically.

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Africa's Talking sandbox (https://account.africastalking.com -> Sandbox -> Settings -> API Key).
# Leave AT_API_KEY empty to log SMS to the console instead of sending.
AT_USERNAME=sandbox
AT_API_KEY=

# Password given to the demo citizen / officer / admin accounts created by `seed_demo`.
# These are test accounts for local and demo use only.
DEMO_PASSWORD=Murang-a-demo-2026
